{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "plume",
  "version": "0.1.1",
  "identifier": "fr.plume.app",
  "mainBinaryName": "plume",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Plume",
        "url": "main.html",
        "width": 860,
        "height": 580,
        "minWidth": 680,
        "minHeight": 440,
        "center": true,
        "visible": false
      },
      {
        "label": "onboarding",
        "title": "Plume",
        "url": "onboarding.html",
        "width": 560,
        "height": 540,
        "resizable": false,
        "center": true,
        "visible": false
      },
      {
        "label": "pill",
        "title": "Plume",
        "url": "pill.html",
        "width": 320,
        "height": 90,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "icon": [
      "../icons/32x32.png",
      "../icons/128x128.png",
      "../icons/128x128@2x.png",
      "../icons/icon.icns",
      "../icons/icon.ico"
    ],
    "publisher": "Pierre Pocquet-Assemien",
    "homepage": "https://github.com/ppocass/plume",
    "license": "MIT",
    "category": "Utility",
    "shortDescription": "Dictée locale et privée / local, private dictation",
    "longDescription": "Plume prend la dictée à la voix, hors ligne : l'audio ne quitte jamais l'ordinateur.\nMoteur Parakeet (25 langues européennes, NVIDIA, licence CC-BY-4.0) exécuté sur le processeur.\n\nPlume takes dictation by voice, entirely offline: the audio never leaves the computer.\nPowered by Parakeet (25 European languages, NVIDIA, CC-BY-4.0 licence) on the CPU.",
    "linux": {
      "deb": {
        "section": "utils",
        "depends": [
          "xdotool"
        ],
        "desktopTemplate": "../packaging/plume.desktop",
        "files": {
          "usr/lib/plume/": "vendor/sherpa/"
        }
      }
    }
  }
}
