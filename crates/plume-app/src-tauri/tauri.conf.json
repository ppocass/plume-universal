{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plume",
  "version": "0.1.0",
  "identifier": "fr.plume.app",
  "mainBinaryName": "plume",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Plume",
        "url": "main.html",
        "width": 860,
        "height": 580,
        "minWidth": 680,
        "minHeight": 440,
        "center": true,
        "visible": false
      },
      {
        "label": "onboarding",
        "title": "Plume",
        "url": "onboarding.html",
        "width": 560,
        "height": 540,
        "resizable": false,
        "center": true,
        "visible": false
      },
      {
        "label": "pill",
        "title": "Plume",
        "url": "pill.html",
        "width": 320,
        "height": 90,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "icon": [
      "../icons/32x32.png",
      "../icons/128x128.png",
      "../icons/128x128@2x.png",
      "../icons/icon.icns",
      "../icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "files": {
          "usr/bin/": "vendor/sherpa/"
        }
      }
    }
  }
}
